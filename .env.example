# =============================================
# KRUZBERG CRM - Environment Variables
# =============================================

# Supabase Configuration
# Get these from: https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Email — OVH SMTP (envoi)
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=587
SMTP_USER=booking@kruzberg.com
SMTP_PASSWORD=your-email-password-here

# Email — OVH IMAP (réception / sync)
IMAP_HOST=ssl0.ovh.net
IMAP_PORT=993
IMAP_USER=booking@kruzberg.com
IMAP_PASSWORD=your-email-password-here

# Cron secret (protection de la route sync)
CRON_SECRET=your-random-secret-here

# Fond de carte (optionnel)
# Sans cette clé, les cartes utilisent Esri Dark Gray (gratuit, sans compte).
# Avec une clé CARTO gratuite (https://carto.com/basemaps/apikey), elles
# retrouvent le fond noir CARTO d'origine.
NEXT_PUBLIC_CARTO_API_KEY=

# Connecteur MCP (Booking Radar → claude.ai) — voir README « Connecteur MCP »
# Secret long et aléatoire (≥ 32 caractères) : openssl rand -hex 32
# Vide = connecteur désactivé (toutes les requêtes renvoient 404).
MCP_SECRET=
# Clé service_role Supabase (Settings → API). SERVEUR UNIQUEMENT, jamais NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# UUID de ton compte (Supabase → Authentication → Users) : propriétaire des données écrites.
MCP_OWNER_ID=
# URL publique du CRM pour les liens renvoyés (optionnel, défaut : domaine de production Vercel)
CRM_PUBLIC_URL=https://kruzberg-crm.vercel.app
